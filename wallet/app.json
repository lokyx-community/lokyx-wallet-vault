{
  "expo": {
    "name": "LOKYX Wallet",
    "slug": "lokyx-wallet",
    "scheme": "lokyx",
    "version": "0.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "xyz.lokyx.wallet",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Confirm payments and open your wallet with Face ID.",
        "NSCameraUsageDescription": "Scan a LOKYX ring or QR code to pay someone.",
        "UIBackgroundModes": ["fetch", "processing"]
      }
    },
    "android": {
      "package": "xyz.lokyx.wallet",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE", "android.permission.SYSTEM_ALERT_WINDOW", "android.permission.READ_CONTACTS", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "LOKYX Wallet",
      "themeColor": "#000000"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "faceIDPermission": "Unlock your LOKYX keys with Face ID." }],
      "expo-font",
      ["expo-local-authentication", { "faceIDPermission": "Confirm payments and open your wallet with Face ID." }],
      "expo-notifications",
      "expo-background-task",
      "./plugins/live-alerts",
      ["expo-camera", { "cameraPermission": "Scan a LOKYX ring or QR code to pay someone.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "Pick a photo of a LOKYX ring or QR code to pay someone." }],
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 88, "backgroundColor": "#000000" }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
