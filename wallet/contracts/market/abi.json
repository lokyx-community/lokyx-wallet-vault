{
  "name": "Market",
  "deploy": [],
  "methods": [
    { "name": "deposit", "args": [], "payable": true },
    { "name": "withdraw", "args": [["amount", "amount"]] },
    { "name": "create", "args": [["title", "string"], ["close", "u64"], ["unit", "amount"], ["panel", "list<address>"]], "returns": "u64" },
    { "name": "place", "args": [["id", "u64"], ["outcome", "u64"], ["side", "u64"], ["price", "u64"], ["qty", "u64"]], "returns": "u64" },
    { "name": "cancel", "args": [["id", "u64"], ["order", "u64"]] },
    { "name": "propose", "args": [["id", "u64"], ["answer", "u64"]] },
    { "name": "dispute", "args": [["id", "u64"]] },
    { "name": "vote", "args": [["id", "u64"], ["vote", "u64"]] },
    { "name": "finalize", "args": [["id", "u64"]] },
    { "name": "expire", "args": [["id", "u64"]] },
    { "name": "claim", "args": [["id", "u64"]], "returns": "amount" },
    { "name": "send", "args": [["id", "u64"], ["to", "address"], ["outcome", "u64"], ["qty", "u64"]] },
    { "name": "count", "args": [], "returns": "u64", "view": true },
    { "name": "free", "args": [["who", "address"]], "returns": "amount", "view": true },
    { "name": "market", "args": [["id", "u64"]], "returns": ["string", "address", "u64", "amount", "u64"], "view": true },
    { "name": "market_more", "args": [["id", "u64"]], "returns": ["u64", "amount", "list<address>", "u64"], "view": true },
    { "name": "resolution", "args": [["id", "u64"]], "returns": ["u64", "address", "u64", "address", "u64"], "view": true },
    { "name": "bond", "args": [["id", "u64"]], "returns": ["amount", "amount"], "view": true },
    { "name": "order_count", "args": [["id", "u64"]], "returns": "u64", "view": true },
    { "name": "order_at", "args": [["id", "u64"], ["index", "u64"]], "returns": ["u64", "address", "u64", "u64", "u64"], "view": true },
    { "name": "shares", "args": [["id", "u64"], ["who", "address"]], "returns": ["u64", "u64"], "view": true }
  ],
  "events": [
    { "name": "Deposit", "fields": [["who", "address"], ["amount", "amount"]] },
    { "name": "Withdraw", "fields": [["who", "address"], ["amount", "amount"]] },
    { "name": "Created", "fields": [["id", "u64"], ["creator", "address"], ["close", "u64"]] },
    { "name": "Order", "fields": [["id", "u64"], ["order", "u64"], ["who", "address"]] },
    { "name": "Proposed", "fields": [["id", "u64"], ["who", "address"], ["answer", "u64"]] },
    { "name": "Disputed", "fields": [["id", "u64"], ["who", "address"]] },
    { "name": "Voted", "fields": [["id", "u64"], ["who", "address"], ["vote", "u64"]] },
    { "name": "Decided", "fields": [["id", "u64"], ["state", "u64"]] },
    { "name": "Sent", "fields": [["id", "u64"], ["from", "address"], ["to", "address"], ["outcome", "u64"], ["qty", "u64"]] }
  ]
}
